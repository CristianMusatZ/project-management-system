# ========================================
# Project Management System - Environment
# ========================================
# Copiază acest fișier ca .env și completează valorile

# ─────────────────────────────────────────────────────
# LOCAL DEVELOPMENT (Docker Compose)
# ─────────────────────────────────────────────────────

# PostgreSQL (local)
POSTGRES_DB=pms_db
POSTGRES_USER=pms_user
POSTGRES_PASSWORD=pms_secret_2024

# MongoDB (local)
MONGO_USER=pms_mongo
MONGO_PASSWORD=pms_mongo_2024
MONGO_DB=pms_projects

# ─────────────────────────────────────────────────────
# RAILWAY DEPLOYMENT
# Setează aceste variabile în Railway dashboard → Service → Variables
# ─────────────────────────────────────────────────────

# PostgreSQL pe Railway (furnizat automat de Railway Postgres plugin)
# DATABASE_URL=postgresql://user:pass@host.railway.app:5432/railway

# MongoDB (folosește MongoDB Atlas - gratuit)
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/pms_projects?retryWrites=true&w=majority

# ─────────────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=1d

# ─────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# URL-ul public al backend-ului (setat automat de Railway, sau manual)
# BACKEND_URL=https://pms-backend.up.railway.app

# Frontend
VITE_API_URL=http://localhost:4000/api
# Pe Railway: VITE_API_URL=https://pms-backend.up.railway.app/api

# ─────────────────────────────────────────────────────
# Brevo — Notificări Email (opțional)
# Dacă BREVO_API_KEY nu e setat, emailurile sunt dezactivate
# (notificările in-app funcționează oricum).
# API Key: dashboard Brevo → SMTP & API → API Keys (xkeysib-...)
# BREVO_FROM trebuie să fie o adresă de expeditor verificată în Brevo.
# ─────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_FROM=noreply@exemplu.ro
BREVO_FROM_NAME=Project Management System
